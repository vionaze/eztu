{
  "name": "kupon",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22.18.0 <25"
  },
  "scripts": {
    "dev": "pnpm prisma:generate && pnpm --filter @kupon/web dev",
    "dev:web": "pnpm --filter @kupon/web dev",
    "dev:webpack": "pnpm prisma:generate && pnpm --filter @kupon/web dev:webpack",
    "build": "pnpm prisma:generate && pnpm --filter @kupon/web build",
    "start": "pnpm --filter @kupon/web start",
    "lint": "pnpm --filter @kupon/web lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "db:migrate": "pnpm --filter @kupon/db db:migrate",
    "db:seed": "pnpm --filter @kupon/db db:seed",
    "products:import:eztopup": "pnpm --filter @kupon/db products:import:eztopup",
    "products:sync:supplier": "pnpm --filter @kupon/db products:sync:supplier",
    "prisma:generate": "pnpm --filter @kupon/db prisma:generate",
    "prisma:validate": "pnpm --filter @kupon/db prisma:validate",
    "deploy:vps": "bash scripts/deploy-vps.sh"
  },
  "devDependencies": {
    "next": "16.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@reown/appkit",
      "@prisma/engines",
      "bufferutil",
      "keccak",
      "prisma",
      "sharp",
      "utf-8-validate",
      "unrs-resolver"
    ]
  }
}
