ORDER_STATUS_CALLBACK_TOKEN=""
ORDER_STATUS_CALLBACK_URL=""
ORDER_CALLBACK_HEALTHCHECK_IPS="161.97.130.68"
SUPPLIER_BALANCE_IDR="1000000"
SUPPLIER_REPLENISH_THRESHOLD_IDR="250000"
SUPPLIER_REPLENISH_TARGET_IDR="1000000"

RESEND_API_KEY=""
EMAIL_FROM="EZTopUp <sales@eztopup.io>"
EMAIL_REPLY_TO="sales@eztopup.io"

