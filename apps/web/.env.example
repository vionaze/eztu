# Comma-separated emails that always get admin UI + /admin access
ADMIN_EMAILS="aigaktidur@gmail.com"
# Comma-separated IPs that can never be access-blocked (VPS egress, office, etc.)
TRUSTED_IPS="161.97.130.68,127.0.0.1"

# Cryptomus crypto payments (Merchant API)
# https://doc.cryptomus.com/merchant-api/request-format
CRYPTOMUS_MERCHANT_ID=""
CRYPTOMUS_PAYMENT_API_KEY=""
CRYPTOMUS_API_URL="https://api.cryptomus.com/v1"
# Optional: force single coin, e.g. USDT. Leave empty to use CRYPTOMUS_CURRENCIES list.
CRYPTOMUS_TO_CURRENCY=""
# Comma-separated stablecoins (used when CRYPTOMUS_TO_CURRENCY is empty)
CRYPTOMUS_CURRENCIES="USDT,USDC"

# Live USD/IDR pricing. Configure at least one provider; the second is fallback.
# Generate FX_QUOTE_SECRET with at least 32 random characters.
OPEN_EXCHANGE_RATES_APP_ID=""
CURRENCYFREAKS_API_KEY=""
FX_QUOTE_SECRET=""
FX_CACHE_MINUTES="10"
FX_MAX_STALE_MINUTES="360"
FX_QUOTE_LIFETIME_MINUTES="10"
# Local/emergency override only. Leave empty in normal production operation.
FX_USD_IDR_RATE_OVERRIDE=""
PAYMENT_INVOICE_EXPIRY_MINUTES="60"

TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
# Default Discord webhook for paid/completed sales and blog fallback
DISCORD_WEBHOOK_URL=""
# Fraud / security alerts (optional; falls back to DISCORD_WEBHOOK_URL)
DISCORD_FRAUD_WEBHOOK_URL=""
# New AI-published articles (optional; falls back to DISCORD_WEBHOOK_URL)
DISCORD_BLOG_WEBHOOK_URL=""

# Persistent disk for admin-uploaded blog WebP files.
# Production example: /var/lib/eztopup/blog-images (must be writable by PM2 user).
# Leave empty locally to use apps/web/.data/blog-images.
BLOG_UPLOAD_DIR=""

# Anonymous, consent-based blog visitor reporting.
# Generate with: openssl rand -hex 32
BLOG_VIEW_HASH_SECRET=""

# KIE Z-Image for automatic blog hero (16:9) + thumbnail (4:3).
# Enable Webhook HMAC in KIE Settings and copy the same key below.
KIE_IMAGE_GENERATION_ENABLED="false"
KIE_API_KEY=""
KIE_API_BASE_URL="https://api.kie.ai"
KIE_WEBHOOK_HMAC_KEY=""
KIE_WEBHOOK_TOLERANCE_SECONDS="300"
# Optional override; defaults to NEXT_PUBLIC_APP_URL + /api/webhooks/kie/blog-images
KIE_CALLBACK_URL=""
# Comma-separated trusted suffixes for generated image downloads.
KIE_IMAGE_ALLOWED_HOSTS="aiquickdraw.com,kie.ai"

# Optional defaults for Blog AI (can also be set in Admin → Settings)
# OpenAI-compatible Chat Completions base URL, without trailing slash extras
BLOG_AI_BASE_URL="https://api.openai.com/v1"
BLOG_AI_API_KEY=""
BLOG_AI_MODEL="gpt-5.6-terra"
# Protect /api/cron/blog-ai — hit hourly from system crontab
CRON_SECRET=""
# Example crontab (interval self-throttled in Settings: 1/2/4/8/12h):
# 5 * * * * curl -fsS -H "Authorization: Bearer $CRON_SECRET" https://eztopup.io/api/cron/blog-ai

# Server-side fulfillment credentials. Keep these out of NEXT_PUBLIC_* and
# do not move them into admin-editable settings.
SUPPLIER_API_URL=""
SUPPLIER_SECRET_KEY=""
SUPPLIER_COUNTRY_CODE="id"
