generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// Auth Models (Clerk identity + local app profile)
// ============================================================

model User {
  id            String   @id @default(cuid())
  clerkId       String   @unique
  name          String?
  email         String?  @unique
  emailVerified Boolean  @default(false)
  identityCreatedAt DateTime?
  image         String?
  walletAddress String?  @unique
  role          Role     @default(USER)
  orders        Order[]
  securityEvents SecurityEvent[]
  lastSeenIp    String?
  lastSeenUserAgent String?
  lastSeenAt    DateTime?
  /// When set, user cannot checkout / use account APIs (local ban)
  bannedAt      DateTime?
  banReason     String?
  bannedBy      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

/// Preventive blocks: email, IP, Clerk id, or local user id.
/// Enforced on checkout + requireClerkUser (not a global site wall).
model AccessBlock {
  id        String          @id @default(cuid())
  kind      AccessBlockKind
  /// Normalized value (email lowercased, IP trimmed, ids as-is)
  value     String
  reason    String?
  active    Boolean         @default(true)
  createdBy String?
  createdAt DateTime        @default(now())
  revokedAt DateTime?
  revokedBy String?

  @@unique([kind, value])
  @@index([active, kind, value])
  @@index([createdAt])
}

// ============================================================
// Product Models
// ============================================================

model Category {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  image     String?
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id          String           @id @default(cuid())
  name        String
  slug        String           @unique
  description String
  image       String
  /// Null = Uncategorized (after category delete or manual clear)
  categoryId  String?
  category    Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  variants    ProductVariant[]
  promoCodes  PromoCode[]
  featured    Boolean          @default(false)
  published   Boolean          @default(false)
  /// Global products are purchasable from every visitor market.
  globalAvailability Boolean   @default(false)
  /// TOP_UP = needs player account fields; VOUCHER = code delivery only
  fulfillmentType ProductFulfillmentType @default(VOUCHER)
  /// When TOP_UP: also require Zone/Server ID (e.g. MLBB)
  requiresServerId Boolean @default(false)
  /// Checkout field labels (optional)
  gameIdLabel    String? @default("User ID")
  serverIdLabel  String? @default("Zone / Server ID")
  orders      OrderItem[]
  analyticsEvents ProductAnalyticsEvent[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model ProductVariant {
  id        String      @id @default(cuid())
  name      String
  published Boolean     @default(true)
  priceIDR  Int
  priceUSD  Float
  supplierCostIDR Int?
  supplierSku     String?
  /// ISO 3166-1 alpha-2 supplier market code, lower-case (id, sg, my, ...)
  countryCode     String      @default("id")
  supplierStatus String?
  supplierPriceUpdatedAt DateTime?
  /// Per-SKU checkout markup imported from EZ All Products; 1000 = 10%.
  nonCryptoMarkupBps Int      @default(1000)
  cryptoMarkupBps    Int      @default(1200)
  productId String
  product   Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orders    OrderItem[]
  analyticsEvents ProductAnalyticsEvent[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([productId, countryCode])
  @@index([supplierSku, countryCode])
}

// ============================================================
// Order Models
// ============================================================

model Order {
  id          String      @id @default(cuid())
  orderNumber String      @unique
  userId      String
  user        User        @relation(fields: [userId], references: [id])
  email       String
  gameId      String
  serverId    String?
  items       OrderItem[]
  supplierOrder SupplierOrder?
  voucherDeliveryLink VoucherDeliveryLink?
  treasuryEntries TreasuryLedgerEntry[]
  securityEvents SecurityEvent[]
  paymentEvents PaymentEvent[]

  // Pricing
  subtotalIDR Int   @default(0)
  subtotalUSD Float @default(0)
  subtotalUSDCents Int @default(0)
  discountIDR Int   @default(0)
  discountUSD Float @default(0)
  discountUSDCents Int @default(0)
  totalIDR    Int
  totalUSD    Float
  totalUSDCents Int @default(0)
  pricingTier PaymentPricingTier?
  supplierCountryCode String?
  supplierCostIDR Int?
  pricingMarkupBps Int?
  pricingVerifiedAt DateTime?

  // Immutable FX quote snapshot used for stablecoin checkout.
  usdIdrRate      Decimal? @db.Decimal(18, 6)
  fxSource        String?
  fxQuotedAt      DateTime?
  fxQuoteExpiresAt DateTime?
  actualPaidUSDCents Int?
  underpaidUSDCents  Int?

  promoCodeId String?
  promoCode   PromoCode? @relation(fields: [promoCodeId], references: [id])

  status OrderStatus @default(PENDING)

  // Payment provider fields
  paymentProvider           String?
  paymentProviderPaymentId  String?   @unique
  paymentProviderInvoiceId  String?
  paymentProviderTxHash     String?
  paymentCurrency           String?
  paymentUrl                String?
  paidAt                    DateTime?
  expiresAt                 DateTime?
  paymentReviewReason       String?
  paymentReviewRequiredAt   DateTime?
  paymentReviewApprovedAt   DateTime?
  paymentReviewApprovedBy   String?
  paymentReviewNote         String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

/// Provider webhook inbox. The provider/event pair is unique so retries are safe.
model PaymentEvent {
  id                String   @id @default(cuid())
  provider          String
  eventId           String
  eventType         String
  providerPaymentId String?
  orderId           String?
  order             Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  payload           Json?
  processedAt       DateTime?
  createdAt         DateTime @default(now())

  @@unique([provider, eventId])
  @@index([orderId, createdAt])
  @@index([provider, providerPaymentId])
  @@index([processedAt])
}

model OrderItem {
  id        String         @id @default(cuid())
  orderId   String
  order     Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product        @relation(fields: [productId], references: [id])
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  quantity  Int            @default(1)
  priceIDR  Int
  priceUSD  Float
  priceUSDCents Int @default(0)
  supplierCostIDR Int?
  supplierCountryCode String?
  pricingMarkupBps Int?
}

model ProductAnalyticsEvent {
  id            String                    @id @default(cuid())
  productId     String
  product       Product                   @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId     String?
  variant       ProductVariant?           @relation(fields: [variantId], references: [id], onDelete: SetNull)
  eventType     ProductAnalyticsEventType
  visitorHash   String
  countryCode   String?
  paymentMethod String?
  reason        String?
  metadata      Json?
  createdAt     DateTime                  @default(now())

  @@index([productId, eventType, createdAt])
  @@index([variantId, eventType, createdAt])
  @@index([visitorHash, createdAt])
  @@index([createdAt])
}

// ============================================================
// Supplier Fulfillment Models
// ============================================================

model SupplierOrder {
  id              String              @id @default(cuid())
  orderId         String              @unique
  order           Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider        String
  providerOrderId String?
  status          SupplierOrderStatus @default(PENDING)
  productName     String
  variantName     String
  costIDR         Int
  voucherCode     String?
  voucherPin      String?
  raw             Json?
  error           String?
  fulfilledAt     DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
}

model VoucherDeliveryLink {
  id             String   @id @default(cuid())
  orderId        String   @unique
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  tokenHash      String   @unique
  email          String
  sentAt         DateTime?
  lastSendError  String?
  firstVisitedAt DateTime?
  lastVisitedAt  DateTime?
  visitCount     Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([sentAt])
  @@index([firstVisitedAt])
  @@index([createdAt])
}

model TreasuryLedgerEntry {
  id          String            @id @default(cuid())
  orderId     String?
  order       Order?            @relation(fields: [orderId], references: [id], onDelete: SetNull)
  type        TreasuryEntryType
  currency    String
  amountIDR   Int?
  amountUSD   Float?
  description String
  metadata    Json?
  createdAt   DateTime          @default(now())
}

model ReplenishmentRequest {
  id                 String              @id @default(cuid())
  status             ReplenishmentStatus @default(OPEN)
  currentBalanceIDR  Int
  thresholdIDR       Int
  targetBalanceIDR   Int
  requestedAmountIDR Int
  note               String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  resolvedAt         DateTime?
}

model SecurityEvent {
  id          String           @id @default(cuid())
  eventType   String
  severity    SecuritySeverity @default(LOW)
  action      SecurityAction   @default(FLAGGED)
  reasons     String[]
  ip          String?
  userAgent   String?
  route       String?
  method      String?
  origin      String?
  referer     String?
  email       String?
  userId      String?
  user        User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  clerkUserId String?
  orderId     String?
  order       Order?           @relation(fields: [orderId], references: [id], onDelete: SetNull)
  productId   String?
  variantId   String?
  metadata    Json?
  createdAt   DateTime         @default(now())

  @@index([eventType, createdAt])
  @@index([userId, createdAt])
  @@index([ip, createdAt])
  @@index([orderId, createdAt])
}

// ============================================================
// Blog Models
// ============================================================

model BlogPost {
  id              String    @id @default(cuid())
  title           String
  slug            String    @unique
  excerpt         String?
  content         String    @db.Text
  /// Hero / OG image (wide)
  coverImage      String?
  /// Card / listing thumbnail (square or 4:3)
  thumbnailImage  String?
  /// English prompt used for KIE Z-Image hero generation or a manual workflow.
  heroImagePrompt String?    @db.Text
  /// English prompt used for KIE Z-Image thumbnail generation or a manual workflow.
  thumbnailImagePrompt String? @db.Text
  category        String?
  /// Target country/locale for the article (e.g. ID, MY, US, GLOBAL)
  countryCode     String    @default("GLOBAL")
  /// SEO
  metaTitle       String?
  metaDescription String?
  focusKeyword    String?
  canonicalUrl    String?
  ogTitle         String?
  ogDescription   String?
  /// JSON-LD article extras / FAQ schema payload as JSON string
  structuredData  Json?
  /// AI generation metadata
  aiGenerated     Boolean   @default(false)
  aiModel         String?
  published       Boolean   @default(false)
  views           Int       @default(0)
  publishedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  imageGenerations BlogImageGeneration[]
  dailyVisits      BlogPostDailyVisit[]

  @@index([published, publishedAt])
  @@index([countryCode, published])
  @@index([category])
}

model BlogPostDailyVisit {
  id          String   @id @default(cuid())
  postId      String
  post        BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  visitorHash String
  /// Jakarta calendar date encoded as a PostgreSQL DATE.
  day         DateTime @db.Date
  createdAt   DateTime @default(now())

  @@unique([postId, visitorHash, day])
  @@index([day])
  @@index([postId, day])
  @@index([visitorHash, day])
}

model BlogImageGeneration {
  id              String                    @id @default(cuid())
  postId          String
  post            BlogPost                  @relation(fields: [postId], references: [id], onDelete: Cascade)
  kind            String
  provider        String                    @default("kie")
  model           String                    @default("z-image")
  prompt          String                    @db.Text
  aspectRatio     String
  taskId          String?                   @unique
  status          BlogImageGenerationStatus @default(SUBMITTING)
  error           String?                   @db.Text
  storedImagePath String?
  completedAt     DateTime?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  @@index([postId, kind, createdAt])
  @@index([status, createdAt])
}

// ============================================================
// App activity logs (admin Logs page)
// ============================================================

model AppLog {
  id        String        @id @default(cuid())
  category  AppLogCategory
  level     AppLogLevel   @default(INFO)
  title     String
  message   String?
  actor     String?
  route     String?
  orderId   String?
  metadata  Json?
  createdAt DateTime      @default(now())

  @@index([category, createdAt])
  @@index([level, createdAt])
  @@index([createdAt])
}

// ============================================================
// Settings Model (key-value store for site config)
// ============================================================

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ============================================================
// Enums
// ============================================================

enum Role {
  USER
  ADMIN
  SUPERADMIN
}

enum BlogImageGenerationStatus {
  SUBMITTING
  PROCESSING
  DOWNLOADING
  SUCCEEDED
  FAILED
}

enum ProductFulfillmentType {
  TOP_UP
  VOUCHER
}

enum PaymentPricingTier {
  NON_CRYPTO
  CRYPTO
}

enum ProductAnalyticsEventType {
  CARD_CLICK
  VIEW
  VARIANT_SELECTED
  PAYMENT_METHOD_SELECTED
  QUOTE_ERROR
  CHECKOUT_SUBMITTED
  CHECKOUT_REJECTED
  PAYMENT_CREATED
}

enum SecuritySeverity {
  LOW
  MEDIUM
  HIGH
}

enum SecurityAction {
  FLAGGED
  BLOCKED
}

enum AccessBlockKind {
  EMAIL
  IP
  CLERK_ID
  USER_ID
}

enum OrderStatus {
  PENDING
  UNDERPAID
  PAYMENT_REVIEW
  PAID
  PROCESSING
  COMPLETED
  FAILED
  EXPIRED
  REFUNDED
  DISPUTED
}

enum SupplierOrderStatus {
  PENDING
  PROCESSING
  FULFILLED
  FAILED
  MANUAL_REVIEW
}

enum TreasuryEntryType {
  CUSTOMER_REVENUE
  SUPPLIER_COST
  PROFIT_ESTIMATE
  SUPPLIER_BALANCE_DEBIT
  FLEXAGIFT_BALANCE_DEBIT
  REPLENISHMENT_REQUEST
}

enum ReplenishmentStatus {
  OPEN
  SENT
  RESOLVED
  CANCELLED
}

enum DiscountType {
  PERCENTAGE
  FIXED_IDR
}

enum AppLogCategory {
  SALES
  PAYMENT
  FULFILLMENT
  AUTH
  SECURITY
  BLOG
  ADMIN
  SYSTEM
}

enum AppLogLevel {
  INFO
  SUCCESS
  WARNING
  ERROR
}

// ============================================================
// Promo Code / Voucher Models
// ============================================================

model PromoCode {
  id            String       @id @default(cuid())
  code          String       @unique
  discountType  DiscountType
  discountValue Float // If PERCENTAGE, 100 = 100%. If FIXED_IDR, 50000 = Rp 50.000. USD discount will be calculated based on exchange rate if needed, or we just rely on IDR and recalculate USD. We can use a simple exchange rate or store FIXED_USD too. Let's just store both for fixed.
  discountUSD   Float? // Only used if discountType is FIXED_IDR

  maxUses   Int       @default(1)
  usedCount Int       @default(0)
  expiresAt DateTime?
  isActive  Boolean   @default(true)

  // Scope: if productId is set, only applies to that product.
  // If null, applies to all products.
  productId String?
  product   Product? @relation(fields: [productId], references: [id])

  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
