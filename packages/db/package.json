{
  "name": "@kupon/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "types": "./src/index.ts",
  "scripts": {
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node --experimental-strip-types src/seed.ts",
    "products:import:eztopup": "node --experimental-strip-types src/import-eztopup-products.ts",
    "products:seed:test-skus": "node --experimental-strip-types src/seed-test-skus.ts",
    "products:sync:supplier": "node --experimental-strip-types src/sync-supplier-products.ts",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "typecheck": "tsc --noEmit --pretty false"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/xlsx": "^0.0.36",
    "dotenv": "^17.4.2",
    "prisma": "^7.8.0",
    "typescript": "^5",
    "xlsx": "^0.18.5"
  }
}
